catalog: ra-development
schema: analytics
table_name: web_sessions_fact
dimensions:
  retail_week:
    sql: (select Retail_Week from ra-development.analytics_seed.retail_calendar c where c.`date` = date(session_start_ts))
  retail_month:
    sql: (select Retail_Month from ra-development.analytics_seed.retail_calendar c where c.`date` = date(session_start_ts))
  retail_year:
    sql: (select Retail_Year from ra-development.analytics_seed.retail_calendar c where c.`date` = date(session_start_ts))
  blended_user_id:
    description: A unique identifier for a user, potentially unified across different platforms or tracking mechanisms.
    group_label: '  Audience'
  company_name:
    group_label: '  Audience'
  device:
    description: The specific type of device, operating system, and browser used to access the website (e.g., 'iPhone; CPU iPhone OS 16_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.5 Mobile/15E148 Safari/604.1').
    group_label: '  Audience'
  device_category:
    description: The general type or brand of the device, such as 'iPhone', 'Android', 'iPad', or 'Windows'. This is a simplified version of the 'Device' field.
    group_label: '  Audience'
  duration_in_s:
    description: The total duration of the web session in seconds.
    group_label: Behavior
  duration_in_s_tier:
    description: Categorizes session duration (in seconds) into predefined time buckets.
    group_label: Behavior
  referrer:
    sql: split(referrer, "?")[SAFE_OFFSET(0)]
    description: The URL of the page that linked the user to the website, excluding any query parameters.
    group_label: '    Acquisition'
  referrer_source:
    sql: "case when ${referrer} like '%blog.rittmananalytics.com%' or ${referrer} like '%medium.com/mark-rittman%' then 'Medium'\n              when ${referrer_host} like '%github%' then 'Github'\n              when ${referrer_host} like '%linkedin%' then 'LinkedIn'\n              when ${referrer_host} like '%google%' or ${referrer_host} like '%bing%' or  ${referrer_host} like '%yahoo%' or ${referrer_host} like '%yandex%' then 'Organic Search'\n              when ${referrer_host} like '%t.co%' or ${referrer_host} like '%twitter%' then 'Twitter'\n              when ${first_page_url} like '%rittmananalytics.com/blog%'  then 'Squarespace'\n              when ${first_page_url} like '%https://rittmananalytics.com/drilltodetail%'  then 'Podcast'\n              else 'Direct'\n    end"
    description: The classified source of the referral traffic, based on the referrer URL or first page URL for certain internal sources. Categories include 'Medium', 'Github', 'LinkedIn', 'Organic Search', 'Twitter', 'Squarespace', 'Podcast', or 'Direct'.
    group_label: '    Acquisition'
  referrer_article_stub:
    sql: "case when ${referrer_source} = 'Medium' and ${referrer_host} = 'blog.rittmananalytics.com' then split(${referrer},'/')[safe_offset(3)]\n              when ${referrer_source} = 'Medium' and ${referrer_host} = 'medium.com' then split(${referrer},'/')[safe_offset(4)]\n              when ${first_page_url} LIKE '%rittmananalytics.com/blog/2%' then SPLIT(first_page_url_path,'/')[safe_OFFSET(5)]\n          end"
    description: If the referrer or first page URL points to a known article (e.g., from Medium or the Rittman Analytics blog), this field provides a unique identifier or slug for that article.
    group_label: '    Acquisition'
  referrer_days_since_post:
    sql: timestamp_diff(${session_start_ts[raw]},${page_first_published.page_first_session_start_ts_raw},DAY)
    description: The number of days between the first publication date of the referring content (if identified and linked to page_first_published) and the start of the current session.
    group_label: '    Acquisition'
  referrer_days_since_post_tier:
    sql: ${referrer_days_since_post}
    bin_boundaries:
    - 1
    - 2
    - 3
    - 4
    - 5
    - 6
    - 7
    - 14
    - 28
    - 90
    - 180
    - 365
    - 730
    description: Categorizes the 'Referrer Days Since Post' into predefined time intervals (1, 2, 3, 4, 5, 6, 7, 14, 28, 90, 180, 365, 730 days).
    group_label: '    Acquisition'
  events:
    label: Session Events
    description: The total count of tracked events (e.g., page views, clicks) that occurred during this specific session.
    group_label: Behavior
  first_page_title:
    label: Entrance Page Title
    description: The title of the first page (entrance page) viewed by the user during this session.
    group_label: Behavior
  first_page_category:
    sql: "case when ${first_page_url} like '%blog%' or ${first_page_url} like '%rittmananalytics.com/202%' or  ${first_page_title} like '%Videos — Rittman Analytics%' then '01: Blog'\n                  when ${first_page_url} like '%drilltodetail%' or ${first_page_url} like '%podcast%' then '01: Podcast'\n                  when ${first_page_url} = '/' or ${first_page_url} like '%home-index%' or ${first_page_title} like '%Scale your Analytics — Rittman Analytics%' then '01: Home Page'\n                  when ${first_page_url} like '%/services/%' or ${first_page_url} like '%/offers/%' or ${first_page_title} like '%Project Discovery — Rittman Analytics%' or ${first_page_title} like '%Looker GenAI — Rittman Analytics%' or ${first_page_title} like '%Looker Jumpstart — Rittman Analytics%' or ${first_page_title} like '%Generative AI — Rittman Analytics%' then '04: Service'\n                  when ${first_page_url} like '%/about/%' or ${first_page_url} like '%/contact%' or ${first_page_url} like\
      \ '%/faqs/%' or ${first_page_url} like '%scv-contact-us-form%' then '08: Contact'\n                  when ${first_page_url} like '%sidebar%' then 'Misc'\n                  when ${first_page_url} like '%/assistant%' then '06: Assistant'\n                  when ${first_page_url} like '%/pricing%' or ${first_page_url} like '%/engagement-model%' or ${first_page_url} like '%/how-we-work%' then '12: Commercials'\n                  when ${first_page_url} like '%scv-thank-you%' or ${first_page_url} like '%/modern-data-stack-thank-you%' then '08: Goal Achieved'\n                  when ${first_page_url} like '%causal-analytics%' or ${first_page_url} like '/scv-download-hubspot-form' then '02: Landing Page'\n                  when ${first_page_url} like '%causal-analytics-video%' or ${first_page_url} like '%download-10-ways-your-modern-data-stack-can-fail%' or ${first_page_url} like '%download-page%' then '04: Gated Content'\n                  when ${first_page_url} like '%industries%' or ${first_page_url}\
      \ like '%about%' or ${first_page_url} like '%partners%' or ${first_page_title} like '%Data Analytics Project Checklist — Rittman Analytics%' then '02: Marketing'\n                  when ${first_page_url} like '%case-studies%' then '03: Case Study'\n                  when ${first_page_url} like '%calendly%' then '06: Conversion'\n              end"
    label: Entrance Page Category
    description: 'A predefined category for the first page (entrance page) viewed in the session, based on its URL or title. Examples include ''01: Blog'', ''01: Podcast'', ''01: Home Page'', ''04: Service''.'
    group_label: Behavior
  first_page_url:
    sql: rtrim(first_page_url,"/")
    label: Entrance Page URL
    description: The full URL of the first page (entrance page) viewed by the user during this session, with any trailing slash removed.
    group_label: Behavior
  first_page_url_host:
    description: The hostname (e.g., 'www.example.com') of the first page (entrance page) viewed in the session. Hidden by default.
    group_label: Behavior
    hidden: true
  first_page_url_path:
    sql: rtrim(first_page_url_path,"/")
    description: The path (e.g., '/blog/article-name') of the first page (entrance page) viewed in the session, with any trailing slash removed. Hidden by default.
    hidden: true
  gclid:
    description: Google Click Identifier (GCLID), used for tracking clicks from Google Ads. Hidden by default.
    hidden: true
  is_bounced_session:
    description: Indicates whether the session was a bounce (Yes/No). A bounce is typically a session with only one page view or interaction.
    group_label: Behavior
  last_page_title:
    label: Exit Page Title
    description: The title of the last page (exit page) viewed by the user before the session ended.
    group_label: Behavior
  last_page_url:
    sql: rtrim(last_page_url,"/")
    label: Exit Page URL
    description: The full URL of the last page (exit page) viewed by the user before the session ended, with any trailing slash removed.
    group_label: Behavior
  last_page_category:
    sql: "case when ${last_page_url} like '%blog%' or ${last_page_url} like '%rittmananalytics.com/202%' then '01: Blog'\n                  when ${last_page_url} like '%drilltodetail%' or ${last_page_url} like '%podcast%' then '01: Podcast'\n                  when ${last_page_url} = '/' or ${last_page_url} like '%home-index%' then '01: Home Page'\n                  when ${last_page_url} like '%/services/%' or ${last_page_url} like '%/offers/%' then '04: Service'\n                  when ${last_page_url} like '%/about/%' or ${last_page_url} like '%/contact%' or ${last_page_url} like '%/faqs/%' or ${last_page_url} like '%scv-contact-us-form%' then '08: Contact'\n                  when ${last_page_url} like '%sidebar%' then 'Misc'\n                  when ${last_page_url} like '%/assistant%' then '06: Assistant'\n                  when ${last_page_url} like '%/pricing%' or ${last_page_url} like '%/engagement-model%' or ${last_page_url} like '%/how-we-work%' then '12: Commercials'\n          \
      \        when ${last_page_url} like '%scv-thank-you%' or ${last_page_url} like '%/modern-data-stack-thank-you%' then '08: Goal Achieved'\n                  when ${last_page_url} like '%causal-analytics%' or ${last_page_url} like '/scv-download-hubspot-form' then '02: Landing Page'\n                  when ${last_page_url} like '%causal-analytics-video%' or ${last_page_url} like '%download-10-ways-your-modern-data-stack-can-fail%' or ${last_page_url} like '%download-page%' then '04: Gated Content'\n                  when ${last_page_url} like '%industries%' or ${last_page_url} like '%about%' or ${last_page_url} like '%partners%'then '02: Marketing'\n                  when ${last_page_url} like '%case-studies%' then '03: Case Study'\n                  when ${last_page_url} like '%calendly%' then '06: Conversion'\n              end"
    label: Exit Page Category
    description: 'A predefined category for the last page (exit page) viewed in the session, based on its URL. Examples include ''01: Blog'', ''01: Podcast'', ''01: Home Page'', ''04: Service''.'
    group_label: Behavior
  last_page_url_host:
    label: Exit Page URL Host
    description: The hostname (e.g., 'www.example.com') of the last page (exit page) viewed in the session.
    group_label: Behavior
  last_page_url_path:
    sql: rtrim(last_page_url_path,"/")
    label: Exit Page URL Path
    description: The path (e.g., '/contact-us') of the last page (exit page) viewed in the session, with any trailing slash removed.
    group_label: Behavior
  mins_between_sessions:
    description: The time in minutes between the start of this session and the end of the user's previous session. Null if this is the user's first session.
    group_label: Behavior
  referrer_host:
    description: The hostname (e.g., 'google.com', 'linkedin.com') of the website that referred the user.
    group_label: '    Acquisition'
  referrer_medium:
    description: The medium of the referral source, often indicating how the user arrived (e.g., 'organic', 'cpc', 'referral', 'social'). This is typically the raw medium from the source data.
    group_label: '    Acquisition'
  search:
    description: The search query or keywords used by the visitor if they arrived from a search engine. May be '(not provided)' or null for privacy reasons or non-search referrals.
    group_label: '    Acquisition'
  session_id:
    description: A unique identifier for this specific web session.
    group_label: Behavior
  periods_ago:
    sql: FLOOR(DATE_DIFF(CURRENT_DATE(), DATE(${session_start_ts[raw]}), DAY) / 30)
  user_session_number:
    description: A sequential number indicating which session this is for the user (e.g., 1 for the first session, 2 for the second).
    group_label: '  Audience'
  new_or_returning_user:
    sql: case when ${user_session_number} = 1 then 'New' else 'Returning' end
    description: Classifies the user as 'New' (if this is their first session, user_session_number = 1) or 'Returning' (if they have had previous sessions).
    group_label: '  Audience'
  web_sessions_pk:
    primary_key: true
    description: The primary key uniquely identifying each web session record. Hidden by default.
    hidden: true
  is_converted_user:
    sql: ${is_converting_blended_user_id}
    description: Indicates (Yes/No) whether the user associated with this session (blended_user_id) has ever performed a defined conversion action.
    group_label: Behavior
  is_converting_session:
    sql: ${is_conversion_session}
    description: Indicates (Yes/No) whether a defined conversion event occurred during this specific session.
    group_label: Behavior
  channel:
    sql: "case when ${session_utm_source} in ('linkedin','facebook') and ${session_utm_medium} = 'paid' then 'Paid Social'\n              when (${session_utm_source} = 'linkedin' or ${referrer_host} like '%linkedin%') and ${session_utm_medium} != 'paid' then 'Organic Social'\n              when channel = 'Social' then 'Organic Social'\n              when channel in ('facebook','linkedin') and ${session_utm_medium} = 'social' then 'Organic Social'\n              when ${session_utm_medium} = 'social' and channel = 'Direct' then 'Organic Social'\n              when ${session_utm_source} = 'substack' and ${session_utm_medium} != 'email' then 'Organic Social'\n              when ${session_utm_source} like 'pocket_%' then 'Referral'\n              when (${referrer_host} like '%rittmananalytics.com%' and ${referrer_host} not like '%blog.rittmananalytics.com%') or ${referrer_host} like 'calendly.com' then 'Direct'\n              when ${referrer_host} like '%medium.com%' or ${referrer_host} like\
      \ '%blog.rittmananalytics.com%'  then 'Organic Social'\n              else channel end"
    description: The marketing channel attributed to this session, determined by custom logic using UTM parameters and referrer information. Examples include 'Paid Social', 'Organic Social', 'Organic Search', 'Referral', 'Direct'.
    group_label: ' Acquisition'
  channel_category:
    sql: "case when ${channel} in ('Paid Social','Paid Search') then 'Paid'\n              when ${channel} in ('Organic Social','Organic Video','Organic Search','Email','Referral') then 'Organic'\n              else ${channel} end"
    description: A higher-level grouping of the marketing channel. 'Paid' includes paid social and paid search; 'Organic' includes organic social, video, search, email, and referrals. Other channels retain their name.
    group_label: ' Acquisition'
  session_utm_campaign:
    sql: lower(${utm_campaign})
    label: Session UTM Campaign
    description: The UTM campaign parameter associated with this session, used to identify a specific promotion or strategic campaign (e.g., 'summer_sale', 'newsletter_q3'). Values are lowercased.
    group_label: ' Acquisition'
  session_utm_content:
    sql: ${utm_content}
    label: Session UTM Content
    description: The UTM content parameter associated with this session, used to differentiate ads or links that point to the same URL (e.g., 'logolink', 'textlink').
    group_label: ' Acquisition'
  session_utm_medium:
    sql: lower(${utm_medium})
    label: Session UTM Medium
    description: The UTM medium parameter associated with this session, indicating the advertising or marketing medium (e.g., 'cpc', 'banner', 'email'). Values are lowercased.
    group_label: ' Acquisition'
  session_utm_source:
    sql: replace(replace(lower(${utm_source}),'/',''),'.com','')
    label: Session UTM Source
    description: The UTM source parameter associated with this session, indicating the referrer or origin of the traffic (e.g., 'google', 'newsletter', 'linkedin'). Values are lowercased and common suffixes like '.com' or slashes are removed.
    group_label: ' Acquisition'
  session_utm_term:
    sql: ${utm_term}
    description: The UTM term (keyword) parameter associated with this session, typically used to identify paid search keywords.
    group_label: ' Acquisition'
  period_normalized:
    sql: "CASE\n        WHEN ${period} = 'Current Period' THEN ${session_start_ts[raw]}\n        WHEN ${period} = 'Prior Year' THEN TIMESTAMP(DATETIME_ADD(DATETIME(${session_start_ts[raw]}), INTERVAL 1 YEAR))\n      END"
    timeframes:
    - date
    - week
    - month
    label: Chart Date
  session_end_ts:
    timeframes:
    - raw
    - day_of_week_name
    - date
    - day_of_year
    - week
    - month
    - month_num
    - year
    label: Session End
    description: The exact date and time when the user's session ended.
    group_label: Dates
  session_start_ts:
    timeframes:
    - raw
    - day_of_week_name
    - date
    - day_of_year
    - week
    - month
    - month_num
    - year
    - fiscal_quarter
    - fiscal_year
    label: Session Start
    description: The exact date and time when the user's session began.
    group_label: Dates
measures:
  count_of_events:
    sql: ${events}
    aggregate_type: sum
    description: The total sum of all recorded events across the selected sessions.
  total_session_duration_in_s:
    sql: timestamp_diff(session_end_ts,session_start_ts,MINUTE)
    aggregate_type: average
    label: Avg Session Duration (mins)
    description: The average duration of user sessions, calculated in minutes from session start to session end. Displayed in mm:ss format.
  total_sessions:
    sql: ${web_sessions_pk}
    aggregate_type: count_distinct
    label: Total Sessions
    description: The total number of unique web sessions based on the web_sessions_pk.
  bounced_session_rate:
    sql: SAFE_DIVIDE(COUNT(DISTINCT(case when ${is_bounced_session} = TRUE then ${web_sessions_pk} end)),${total_sessions})
    label: Bounced Session Rate
    description: The percentage of sessions that were bounces, calculated as (bounced sessions / total sessions).
    format: percent_2
