catalog: ra-development
schema: analytics
table_name: engagement_sprint_burn_fact
dimensions:
  engagement_sprint_burn_pk:
    primary_key: true
    hidden: true
  engagement_fk:
    hidden: true
  sprint_fk:
    hidden: true
  engagement_code:
    label: Engagement Code
  company_name:
    label: Company Name
  engagement_name:
    label: Engagement Name
  sprint_name:
    label: Sprint
    description: Harvest project name inside the engagement.
  sprint_start_date:
    label: Sprint Start
  sprint_end_date:
    label: Sprint End
  sprint_window:
    sql: "CONCAT(FORMAT_DATE('%e %b', ${sprint_start_date}), ' to ',\n      FORMAT_DATE('%e %b %Y', ${sprint_end_date}))"
    label: Delivery Window
    description: Sprint start and end, formatted for the sprint burn table.
  sprint_state:
    label: Sprint State
    description: Scheduled, Not started, Not started late, In flight, At budget in flight, Over budget in flight, Closed on budget, or Closed over budget.
  sprint_state_sort_order:
    sql: "CASE ${sprint_state}\n              WHEN 'Over budget, in flight' THEN 1\n              WHEN 'Not started, late'      THEN 2\n              WHEN 'Closed over budget'     THEN 3\n              WHEN 'At budget, in flight'   THEN 4\n              WHEN 'In flight'              THEN 5\n              WHEN 'Closed on budget'       THEN 6\n              WHEN 'Not started'            THEN 7\n              ELSE 8 END"
    hidden: true
  sprint_is_closed:
    label: Sprint Is Closed
  sprint_is_over_budget:
    label: Sprint Is Over Budget
  last_hours_booked_date:
    label: Last Hours Booked
  sprint_days_late_start:
    label: Days Late To Start
    description: Days past the sprint start date with no hours booked.
  reporting_month:
    timeframes:
    - month
    - quarter
    - year
    - date
    convert_tz: false
    label: Reporting
measures:
  sprint_count:
    aggregate_type: count
    label: Sprints
    drill_fields:
    - engagement_sprint_burn_fact.engagement_name
    - engagement_sprint_burn_fact.sprint_name
    - engagement_sprint_burn_fact.sprint_window
    - engagement_sprint_burn_fact.sprint_budget_hours
    - engagement_sprint_burn_fact.sprint_hours_to_date
    - engagement_sprint_burn_fact.sprint_budget_used_pct
    - engagement_sprint_burn_fact.sprint_state
    - engagement_sprint_burn_fact.last_hours_booked_date
  sprint_budget_hours:
    sql: sprint_budget_hours
    aggregate_type: sum
    label: Budget Hours
    format: number_1
  sprint_hours_to_date:
    sql: sprint_hours_to_date
    aggregate_type: sum
    label: Hours Billed
    format: number_1
  sprint_hours_in_month:
    sql: sprint_hours_in_month
    aggregate_type: sum
    label: Hours In Month
    format: number_1
  sprint_fee_amount_gbp:
    sql: sprint_fee_amount_gbp
    aggregate_type: sum
    label: Sprint Fee
    format: gbpcurrency_0
  sprint_budget_used_pct:
    sql: 100 * SAFE_DIVIDE(${sprint_hours_to_date}, NULLIF(${sprint_budget_hours}, 0))
    label: Budget Used %
    description: Hours billed over budget hours, for the sprint rows in scope. Use with the data bar cell visualisation.
    format: number_0
  sprints_over_budget:
    aggregate_type: count
    filters:
      sprint_is_over_budget:
        is: true
    label: Sprints Over Budget
